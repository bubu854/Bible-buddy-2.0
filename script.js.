
const content = document.getElementById("content");

const pages = {
  home: {
    title: "Welcome to Bible Buddy ❤️",
    description: "Spend time with God today."
  },
  bible: {
    title: "📖 Read the Bible",
    description: "Explore the Word of God."
  },
  buddy: {
    title: "🤖 Talk to Buddy",
    description: "Ask Buddy anything about the Bible."
  },
  record: {
    title: "🎙️ Sermon Recorder",
    description: "Record your sermons and notes."
  },
  daily: {
    title: "✨ Daily Verse",
    description: "Be strong and courageous. — Joshua 1:9"
  },
  journal: {
    title: "📓 My Journal",
    description: "Write down your thoughts and lessons."
  },
  prayer: {
    title: "🙏 Prayer List",
    description: "Keep track of your prayers."
  },
  quiz: {
    title: "🧠 Bible Quiz",
    description: "Test your Bible knowledge."
  },
  plans: {
    title: "📅 Reading Plans",
    description: "Choose a Bible reading plan."
  },
  maps: {
    title: "🗺️ Bible Maps",
    description: "Explore places from the Bible."
  },
  settings: {
    title: "⚙️ Settings",
    description: "Customize your Bible Buddy experience."
  }
};

function showPage(page) {
  if (!content) {
    console.error("Bible Buddy: content element not found.");
    return;
  }

  const selected = pages[page] || pages.home;

  content.innerHTML = `
    <h2>${selected.title}</h2>
    <p>${selected.description}</p>
    ${page !== "home"
      ? '<button id="backHome">🏠 Back home</button>'
      : ""}
  `;

  const backButton = document.getElementById("backHome");

  if (backButton) {
    backButton.addEventListener("click", () => {
      showPage("home");
    });
  }
}

// Navigation
document.addEventListener("click", (event) => {
  const button = event.target.closest("[data-page]");

  if (button) {
    showPage(button.dataset.page);
  }
});

// Start app
showPage("home");

