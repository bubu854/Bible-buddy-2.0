
const content = document.getElementById("content");

const pages = {
  home: ["Welcome to Bible Buddy ❤️", "Spend time with God today."],
  bible: ["📖 Read the Bible", "Your Bible library will go here."],
  buddy: ["🤖 Talk to Buddy", "Ask Buddy questions about the Bible."],
  record: ["🎙️ Sermon Recorder", "Recording tools will go here."],
  daily: ["✨ Daily Verse", "Be strong and courageous. — Joshua 1:9"],
  journal: ["📓 My Journal", "Write down your thoughts and lessons."],
  prayer: ["🙏 Prayer List", "Keep your prayers here."],
  quiz: ["🧠 Bible Quiz", "Test your Bible knowledge."],
  plans: ["📅 Reading Plans", "Choose a Bible reading plan."],
  maps: ["🗺️ Bible Maps", "Explore places from the Bible."],
  settings: ["⚙️ Settings", "Settings will go here."]
};

function showPage(page) {
  const selected = pages[page] || pages.home;

  content.innerHTML = `
    <h2>${selected[0]}</h2>
    <p>${selected[1]}</p>
    <button id="backHome">🏠 Back home</button>
  `;

  document.getElementById("backHome").addEventListener("click", () => {
    showPage("home");
  });
}

document.querySelectorAll("[data-page]").forEach(button => {
  button.addEventListener("click", () => {
    showPage(button.dataset.page);
  });
});

document.getElementById("settings").addEventListener("click", () => {
  showPage("settings");
});

showPage("home");
