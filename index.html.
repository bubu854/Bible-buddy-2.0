  <main>
    <h2>Welcome back!</h2>
    <p>Your Bible companion is here.</p>

    <section class="menu">
      <button data-page="bible">📖 Read the Bible</button>
      <button data-page="buddy">🤖 Talk to Buddy</button>
      <button data-page="record">🎙️ Record a sermon</button>
      <button data-page="daily">✨ Daily verse</button>
      <button data-page="journal">📓 My journal</button>
      <button data-page="prayer">🙏 Prayer list</button>
      <button data-page="quiz">🧠 Bible quiz</button>
      <button data-page="plans">📅 Reading plans</button>
      <button data-page="maps">🗺️ Bible maps</button>
    </section>

    <section id="content">
      <h2>Today's reminder</h2>
      <p>“Be strong and courageous.” – Joshua 1:9</p>
      <p>Spend some time with God today.</p>
    </section>
  </main>

  <nav>
    <button data-page="home">Home</button>
    <button data-page="bible">Bible</button>
    <button data-page="buddy">Buddy</button>
    <button data-page="record">Record</button>
  </nav>

  <script src="script.js"></script>
